{
  "permissions": {
    "defaultMode": "auto",
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh issue create *)",
      "Bash(rm *)",
      "Bash(git clean *)",
      "Bash(git reset *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl delete *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/ai-console-statusline.sh",
    "padding": 0
  },
  "hooks": {
    "SessionStart": [],
    "Stop": [],
    "SessionEnd": []
  }
}
