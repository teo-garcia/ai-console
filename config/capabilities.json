      "description": "Current library and framework documentation",
      "risk": "read-only",
      "activation": "global",
      "implementations": [
        {
          "id": "cursor-context7-plugin",
          "kind": "plugin",
          "clients": ["cursor"],
          "pluginName": "context7-plugin",
          "selector": "/docs",
          "supersedesMcp": "context7",
          "approval": "auto",
          "useWhen": "Cursor can isolate documentation lookup through the verified plugin's skill, command, and research subagent"
        },
        {
          "id": "context7",
          "kind": "mcp",
          "clients": [
            "codex-desktop",
            "codex-cli",
            "codex-ide",
            "claude",
            "cursor",
            "opencode"
          ],
          "mcpServer": "context7",
          "approval": "auto",
          "useWhen": "Version-sensitive library or framework API guidance"
        }
      ]
    },
