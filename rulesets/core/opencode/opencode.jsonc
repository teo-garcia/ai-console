{
  "$schema": "https://opencode.ai/config.json",

  // MCP baseline shared with Codex / Claude
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "datadog": {
      "type": "remote",
      "url": "https://mcp.us5.datadoghq.com/api/unstable/mcp-server/mcp",
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true,
      "env": { "CHROME_DEBUG_PORT": "9222" }
    },
    "postgres": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://user:pass@localhost:5432/dev_db"
      ],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/juan.garcia"
      ],
      "enabled": true
    },
    "serena": {
      "type": "local",
      "command": [
        "/Users/juan.garcia/.local/bin/uvx",
        "-p",
        "3.13",
        "--from",
        "git+https://github.com/oraios/serena@95583663272ddf5d6e07ae6b99aeb05da3e59fdf",
        "serena",
        "start-mcp-server",
        "--project-from-cwd",
        "--context=ide"
      ],
      "env": {
        "PATH": "/Users/juan.garcia/.nvm/versions/node/v22.22.2/bin:/Users/juan.garcia/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
      },
      "enabled": true
    },
    "codebase-memory": {
      "type": "local",
      "command": [
        "/Users/juan.garcia/.nvm/versions/node/v22.22.2/bin/npx",
        "-y",
        "codebase-memory-mcp@0.9.0"
      ],
      "env": {
        "PATH": "/Users/juan.garcia/.nvm/versions/node/v22.22.2/bin:/Users/juan.garcia/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
      },
      "enabled": true
    }
  }
}
