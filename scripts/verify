#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

failures=0
warnings=0

ok() {
  echo "ok: $1"
}

warn() {
  warnings=$((warnings + 1))
  echo "warn: $1"
}

fail() {
  failures=$((failures + 1))
  echo "fail: $1"
}

check_exists() {
  local path="$1"
  if [[ -e "$path" ]]; then
    ok "exists $path"
  else
    fail "missing $path"
  fi
}

check_symlink_target() {
  local path="$1"
  local expected="${2:-}"
  if [[ -L "$path" ]]; then
    if [[ -e "$path" ]]; then
      if [[ -n "$expected" && "$(readlink "$path")" != "$expected" ]]; then
        fail "unexpected symlink target $path -> $(readlink "$path")"
      else
        ok "symlink target resolves $path"
      fi
    else
      fail "broken symlink $path"
    fi
  else
    warn "not a symlink $path"
  fi
}

check_json() {
  local path="$1"
  if python3 -m json.tool "$path" >/dev/null 2>&1; then
    ok "valid json $path"
  else
    fail "invalid json $path"
  fi
}

check_jsonc() {
  local path="$1"
  local status
  status="$(python3 - "$path" <<'PY'
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
text = path.read_text(encoding="utf-8")

# Strip C-style comments while respecting strings.
out = []
i = 0
in_string = False
escape = False
while i < len(text):
    c = text[i]
    c2 = text[i:i+2]
    if in_string:
        out.append(c)
        if escape:
            escape = False
        elif c == "\\":
            escape = True
        elif c == '"':
            in_string = False
        i += 1
    elif c2 == "//":
        while i < len(text) and text[i] != "\n":
            i += 1
    elif c2 == "/*":
        i += 2
        while i < len(text) and text[i-2:i] != "*/":
            i += 1
    else:
        if c == '"':
            in_string = True
        out.append(c)
        i += 1

clean = "".join(out)
try:
    json.loads(clean)
    print("valid")
except Exception as e:
    print(f"invalid: {e}")
PY
)"

  if [[ "$status" == "valid" ]]; then
    ok "valid jsonc $path"
  else
    fail "invalid jsonc $path ($status)"
  fi
}

check_toml() {
  local path="$1"
  local status
  status="$(python3 - "$path" <<'PY'
import pathlib
import sys

try:
    import tomllib  # type: ignore[attr-defined]
except ModuleNotFoundError:
    try:
        import tomli as tomllib
    except ModuleNotFoundError:
        print("missing-parser")
        sys.exit(0)

path = pathlib.Path(sys.argv[1])

try:
    tomllib.loads(path.read_text(encoding="utf-8"))
except Exception:
    print("invalid")
    sys.exit(0)

print("valid")
PY
)"

  case "$status" in
    valid)
      ok "valid toml $path"
      ;;
    invalid)
      fail "invalid toml $path"
      ;;
    missing-parser)
      warn "skipped toml validation for $path because no TOML parser is available in python3"
      ;;
    *)
      fail "unexpected toml validation status for $path: $status"
      ;;
  esac
}

check_placeholder_tokens() {
  local path="$1"
  if rg -n --fixed-strings 'your_token' "$path" >/dev/null 2>&1; then
    warn "placeholder token found in $path"
  else
    ok "no your_token placeholder in $path"
  fi

  if rg -n --fixed-strings 'your_key' "$path" >/dev/null 2>&1; then
    warn "placeholder key found in $path"
  else
    ok "no your_key placeholder in $path"
  fi
}

check_machine_path() {
  local path="$1"
  if rg -n '/Users/' "$path" >/dev/null 2>&1; then
    warn "machine specific path found in $path"
  else
    ok "no machine specific /Users path in $path"
  fi
}

check_lean_baseline() {
  local path="$1"
  if rg -n 'basic-memory|datadog|chrome-devtools|filesystem|postgres|serena|codebase-memory' "$path" >/dev/null 2>&1; then
    fail "non-baseline MCP found in $path"
  else
    ok "lean MCP baseline in $path"
  fi
}

echo "verify: checking ai-console templates"

check_exists "$ROOT/mcp/codex.config.toml"
check_exists "$ROOT/mcp/claude.mcp.json"
check_exists "$ROOT/mcp/cursor.mcp.json"
check_exists "$ROOT/rulesets/core/opencode/opencode.jsonc"
check_exists "$ROOT/config/targets.json"
check_exists "$ROOT/registry/repos.json"
check_exists "$ROOT/rulesets/core/codex/AGENTS.md"
check_exists "$ROOT/rulesets/core/claude/CLAUDE.md"
check_exists "$ROOT/rulesets/core/cursor/rules/core.mdc"
check_exists "$ROOT/rulesets/core/opencode/AGENTS.md"
check_exists "$ROOT/vendor/mattpocock-skills/skills/productivity/grill-me/SKILL.md"
check_exists "$ROOT/vendor/mattpocock-skills/skills/engineering/grill-with-docs/SKILL.md"
check_exists "$ROOT/vendor/vercel-labs-agent-skills/skills/react-best-practices/SKILL.md"
check_exists "$ROOT/vendor/shadcn-ui/skills/shadcn/SKILL.md"
check_exists "$ROOT/vendor/shadcn-improve/skills/improve/SKILL.md"
check_exists "$ROOT/scripts/toggle-skill"

for profile in browser codebase memory semantic ops; do
  check_exists "$ROOT/mcp/profiles/$profile/codex.config.toml"
  check_exists "$ROOT/mcp/profiles/$profile/claude.mcp.json"
  check_exists "$ROOT/mcp/profiles/$profile/cursor.mcp.json"
  check_exists "$ROOT/mcp/profiles/$profile/opencode.jsonc"
done

check_symlink_target "$ROOT/AGENTS.md" "$ROOT/rulesets/core/codex/AGENTS.md"
check_symlink_target "$ROOT/CLAUDE.md" "$ROOT/rulesets/core/claude/CLAUDE.md"
check_symlink_target "$ROOT/.cursor/rules" "$ROOT/rulesets/core/cursor/rules"
check_symlink_target "$HOME/.cursor/mcp.json" "$ROOT/mcp/cursor.mcp.json"
check_symlink_target "$HOME/.config/opencode/opencode.jsonc" "$ROOT/rulesets/core/opencode/opencode.jsonc"

for skills_dir in "$HOME/.codex/skills" "$HOME/.cursor/skills" "$HOME/.claude/skills" "$HOME/.config/opencode/skills"; do
  check_symlink_target "$skills_dir/grill-me" "$ROOT/vendor/mattpocock-skills/skills/productivity/grill-me"
  check_symlink_target "$skills_dir/grill-with-docs" "$ROOT/vendor/mattpocock-skills/skills/engineering/grill-with-docs"
done

check_json "$ROOT/mcp/claude.mcp.json"
check_json "$ROOT/mcp/cursor.mcp.json"
check_json "$ROOT/config/targets.json"
check_json "$ROOT/registry/repos.json"
check_jsonc "$ROOT/rulesets/core/opencode/opencode.jsonc"
check_toml "$ROOT/mcp/codex.config.toml"

for profile in browser codebase memory semantic ops; do
  check_json "$ROOT/mcp/profiles/$profile/claude.mcp.json"
  check_json "$ROOT/mcp/profiles/$profile/cursor.mcp.json"
  check_jsonc "$ROOT/mcp/profiles/$profile/opencode.jsonc"
  check_toml "$ROOT/mcp/profiles/$profile/codex.config.toml"
done

check_placeholder_tokens "$ROOT/mcp/codex.config.toml"
check_placeholder_tokens "$ROOT/rulesets/core/opencode/opencode.jsonc"
check_placeholder_tokens "$ROOT/mcp/claude.mcp.json"
check_placeholder_tokens "$ROOT/mcp/cursor.mcp.json"
check_machine_path "$ROOT/mcp/codex.config.toml"
check_machine_path "$ROOT/rulesets/core/opencode/opencode.jsonc"
check_lean_baseline "$ROOT/mcp/codex.config.toml"
check_lean_baseline "$ROOT/mcp/claude.mcp.json"
check_lean_baseline "$ROOT/mcp/cursor.mcp.json"
check_lean_baseline "$ROOT/rulesets/core/opencode/opencode.jsonc"

echo "verify: complete (failures=$failures warnings=$warnings)"

if [[ $failures -gt 0 ]]; then
  exit 1
fi
