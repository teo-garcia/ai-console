#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GSTACK="$ROOT/vendor/gstack"

if [[ ! -f "$GSTACK/setup" ]]; then
  echo "missing gstack submodule; run: git submodule update --init --recursive" >&2
  exit 1
fi

if ! command -v bun >/dev/null 2>&1; then
  echo "gstack requires Bun; install it before running this script" >&2
  exit 1
fi

for host in claude codex opencode; do
  "$GSTACK/setup" --host "$host" --no-prefix --quiet
done

# gstack documents Cursor support and ships a Cursor host generator, but its
# current setup entry point does not accept --host cursor. Install that emitted
# format directly until upstream wires the host into setup.
(
  cd "$GSTACK"
  bun run gen:skill-docs --host cursor
)

cursor_source="$GSTACK/.cursor/skills"
cursor_dest="$HOME/.cursor/skills"
mkdir -p "$cursor_dest"

cursor_runtime="$cursor_dest/gstack"
if [[ -L "$cursor_runtime" ]]; then
  unlink "$cursor_runtime"
fi
mkdir -p "$cursor_runtime/browse" "$cursor_runtime/gstack-upgrade" "$cursor_runtime/review"
ln -sfn "$cursor_source/gstack/SKILL.md" "$cursor_runtime/SKILL.md"
ln -sfn "$GSTACK/bin" "$cursor_runtime/bin"
ln -sfn "$GSTACK/browse/dist" "$cursor_runtime/browse/dist"
ln -sfn "$GSTACK/browse/bin" "$cursor_runtime/browse/bin"
ln -sfn "$cursor_source/gstack-upgrade/SKILL.md" "$cursor_runtime/gstack-upgrade/SKILL.md"
ln -sfn "$GSTACK/ETHOS.md" "$cursor_runtime/ETHOS.md"

for runtime_file in checklist.md TODOS-format.md; do
  ln -sfn "$GSTACK/review/$runtime_file" "$cursor_runtime/review/$runtime_file"
done

for skill_dir in "$cursor_source"/gstack*/; do
  [[ -f "$skill_dir/SKILL.md" ]] || continue
  skill_name="$(basename "$skill_dir")"
  [[ "$skill_name" == "gstack" ]] && continue
  ln -sfn "$skill_dir" "$cursor_dest/$skill_name"
  echo "linked: $cursor_dest/$skill_name -> $skill_dir"
done
