#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
action="${1:-}"
skill_name="${2:-}"

usage() {
  echo "usage: scripts/toggle-skill <enable|disable|status> improve"
}

if [[ "$skill_name" != "improve" ]]; then
  usage
  exit 2
fi

case "$action" in
  enable|disable|status) ;;
  *)
    usage
    exit 2
    ;;
esac

source_path="$ROOT/vendor/shadcn-improve/skills/improve"

if [[ ! -f "$source_path/SKILL.md" ]]; then
  echo "missing skill: $source_path/SKILL.md"
  exit 1
fi

while IFS= read -r skills_dir; do
  skills_dir="${skills_dir/#\~/$HOME}"
  skill_link="$skills_dir/$skill_name"

  case "$action" in
    enable)
      mkdir -p "$skills_dir"
      if [[ -e "$skill_link" && ! -L "$skill_link" ]]; then
        echo "skip: $skill_link exists and is not a symlink"
        continue
      fi
      ln -sfn "$source_path" "$skill_link"
      echo "enabled: $skill_link -> $source_path"
      ;;
    disable)
      if [[ -L "$skill_link" && "$(readlink "$skill_link")" == "$source_path" ]]; then
        unlink "$skill_link"
        echo "disabled: $skill_link"
      else
        echo "inactive: $skill_link"
      fi
      ;;
    status)
      if [[ -L "$skill_link" && "$(readlink "$skill_link")" == "$source_path" ]]; then
        echo "enabled: $skill_link"
      else
        echo "disabled: $skill_link"
      fi
      ;;
  esac
done < <(AI_CONSOLE_TARGETS="$ROOT/config/targets.json" python3 - <<'PY'
import json
import os

with open(os.environ["AI_CONSOLE_TARGETS"], "r", encoding="utf-8") as f:
    targets = json.load(f)["global"]

for client in ("codex", "cursor", "claude", "opencode"):
    print(targets[client]["skillsDir"])
PY
)
