{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@1.2.0",
        "--slim"
      ],
      "enabled": true
    },
    "datadog": {
      "type": "remote",
      "url": "https://mcp.us5.datadoghq.com/api/unstable/mcp-server/mcp",
      "enabled": true
    },
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v2/mcp",
      "enabled": true
    },
    "circleci": {
      "type": "remote",
      "url": "https://mcp.circleci.com/v1/mcp",
      "enabled": true
    }
  },
  "plugin": [
    [
      "opencode-goal-plugin@0.8.2",
      {
        "persistState": false
      }
    ]
  ],
  "command": {
    "goal": {
      "description": "Set a session-scoped goal and auto-continue until complete.",
      "template": "$ARGUMENTS",
      "agent": "build"
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "git clean*": "ask",
      "git reset*": "ask",
      "rm *": "ask",
      "gh pr create*": "ask",
      "gh pr merge*": "ask",
      "gh pr ready*": "ask",
      "gh pr comment*": "ask",
      "gh pr review*": "ask",
      "gh issue create*": "ask",
      "gh issue comment*": "ask",
      "gh api * -X *": "ask",
      "gh api * --method *": "ask",
      "gh api * -f *": "ask",
      "gh api * -F *": "ask",
      "gh api * --field *": "ask",
      "gh api * --raw-field *": "ask",
      "gh api * --input *": "ask",
      "terraform apply*": "ask",
      "terraform destroy*": "ask",
      "kubectl apply*": "ask",
      "kubectl delete*": "ask",
      "kubectl config use-context*": "ask"
    }
  }
}
