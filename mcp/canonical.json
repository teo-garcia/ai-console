{
  "managedServers": [
    "context7",
    "datadog",
    "chrome-devtools",
    "atlassian",
    "circleci"
  ],
  "retiredServers": [
    "filesystem",
    "postgres",
    "postgres-archived",
    "_serena",
    "serena",
    "codebase-memory",
    "basic-memory",
    "github"
  ],
  "global": {
    "servers": [
      "context7",
      "chrome-devtools",
      "datadog",
      "atlassian",
      "circleci"
    ]
  },
  "profiles": {},
  "servers": {
    "context7": {
      "transport": "remote",
      "url": "https://mcp.context7.com/mcp",
      "approvalMode": "auto"
    },
    "chrome-devtools": {
      "transport": "local",
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@1.2.0", "--slim"],
      "approvalMode": "writes"
    },
    "datadog": {
      "transport": "remote",
      "url": "https://mcp.us5.datadoghq.com/api/unstable/mcp-server/mcp",
      "auth": "oauth",
      "approvalMode": "prompt"
    },
    "atlassian": {
      "transport": "remote",
      "url": "https://mcp.atlassian.com/v2/mcp",
      "auth": "oauth",
      "approvalMode": "prompt"
    },
    "circleci": {
      "transport": "remote",
      "url": "https://mcp.circleci.com/v1/mcp",
      "auth": "oauth",
      "approvalMode": "prompt"
    }
  }
}
