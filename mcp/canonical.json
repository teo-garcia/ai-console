{
  "managedServers": [
    "context7",
    "basic-memory",
    "datadog",
    "chrome-devtools",
    "filesystem",
    "postgres",
    "postgres-archived",
    "_serena",
    "serena",
    "codebase-memory"
  ],
  "global": {
    "servers": ["context7"]
  },
  "profiles": {
    "browser": {
      "servers": ["chrome-devtools"]
    },
    "codebase": {
      "servers": ["codebase-memory"]
    },
    "memory": {
      "servers": ["basic-memory"]
    },
    "ops": {
      "servers": ["datadog"]
    },
    "semantic": {
      "servers": ["serena"]
    }
  },
  "servers": {
    "context7": {
      "transport": "remote",
      "url": "https://mcp.context7.com/mcp",
      "approvalMode": "auto"
    },
    "chrome-devtools": {
      "transport": "local",
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@1.2.0", "--slim"],
      "approvalMode": "writes",
      "env": {
        "CHROME_DEBUG_PORT": "9222"
      }
    },
    "codebase-memory": {
      "transport": "local",
      "command": "npx",
      "args": ["-y", "codebase-memory-mcp@0.9.0"],
      "approvalMode": "writes",
      "startupTimeoutSec": 30
    },
    "basic-memory": {
      "transport": "local",
      "command": "uvx",
      "args": ["--from", "basic-memory==0.22.1", "basic-memory", "mcp"],
      "approvalMode": "writes",
      "startupTimeoutSec": 30
    },
    "datadog": {
      "transport": "remote",
      "url": "https://mcp.us5.datadoghq.com/api/unstable/mcp-server/mcp",
      "auth": "oauth",
      "approvalMode": "prompt"
    },
    "serena": {
      "transport": "local",
      "command": "/bin/sh",
      "args": [
        "-c",
        "case \"$XDG_CACHE_HOME\" in /*) serena_home=\"$XDG_CACHE_HOME/ai-console/serena\" ;; *) serena_home=\"$HOME/.cache/ai-console/serena\" ;; esac; export SERENA_HOME=\"$serena_home\"; umask 077; mkdir -p \"$serena_home\"; serena_config=\"$serena_home/serena_config.yml\"; if [ ! -f \"$serena_config\" ]; then printf 'projects: []\\nproject_serena_folder_location: \"%s/projects/$projectDir\"\\n' \"$serena_home\" > \"$serena_config\"; fi; exec uvx -p 3.13 --from git+https://github.com/oraios/serena@95583663272ddf5d6e07ae6b99aeb05da3e59fdf serena start-mcp-server --project-from-cwd --enable-web-dashboard false --open-web-dashboard false --enable-gui-log-window false --context=${SERENA_CONTEXT}"
      ],
      "approvalMode": "writes",
      "startupTimeoutSec": 30,
      "clientValues": {
        "SERENA_CONTEXT": {
          "codex": "codex",
          "claude": "claude-code",
          "cursor": "ide",
          "opencode": "ide"
        }
      }
    }
  }
}
