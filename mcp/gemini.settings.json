{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "datadog": {
      "type": "http",
      "url": "https://mcp.us5.datadoghq.com/api/unstable/mcp-server/mcp"
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "env": {
        "CHROME_DEBUG_PORT": "9222"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/juan.garcia"
      ]
    },
    "serena": {
      "command": "/Users/juan.garcia/.local/bin/uvx",
      "env": {
        "PATH": "/Users/juan.garcia/.nvm/versions/node/v22.22.2/bin:/Users/juan.garcia/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
      },
      "args": [
        "-p",
        "3.13",
        "--from",
        "git+https://github.com/oraios/serena@95583663272ddf5d6e07ae6b99aeb05da3e59fdf",
        "serena",
        "start-mcp-server",
        "--project-from-cwd",
        "--context=ide"
      ]
    },
    "codebase-memory": {
      "command": "/Users/juan.garcia/.nvm/versions/node/v22.22.2/bin/npx",
      "args": ["-y", "codebase-memory-mcp@0.9.0"],
      "env": {
        "PATH": "/Users/juan.garcia/.nvm/versions/node/v22.22.2/bin:/Users/juan.garcia/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
      }
    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://user:pass@localhost:5432/dev_db"
      ]
    }
  },
  "general": {
    "sessionRetention": {
      "warningAcknowledged": true,
      "enabled": true,
      "maxAge": "30d"
    }
  },
  "security": {
    "auth": {
      "selectedType": "oauth-personal"
    }
  },
  "ui": {
    "theme": "Default",
    "inlineThinkingMode": "full",
    "hideTips": true,
    "showMemoryUsage": true,
    "loadingPhrases": "witty"
  },
  "model": {
    "name": ""
  },
  "tools": {
    "shell": {
      "showColor": false
    }
  }
}
